# Apache Configuration for InfinityFree Hosting (zaydaly05.wuaze.com)
RewriteEngine On
RewriteBase /

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Handle Clean Route URLs to HTML Files
RewriteRule ^projects/?$ projects.html [L,QSA]
RewriteRule ^experience/?$ experience.html [L,QSA]
RewriteRule ^skills/?$ skills.html [L,QSA]
RewriteRule ^contact/?$ contact.html [L,QSA]

# API routes mapping to PHP backend handlers
RewriteRule ^api/portfolio/?$ api/portfolio.php [L,QSA]
RewriteRule ^api/status/?$ api/status.php [L,QSA]
RewriteRule ^api/reviews/?$ api/reviews.php [L,QSA]
RewriteRule ^api/star/?$ api/star.php [L,QSA]
RewriteRule ^api/contact/?$ api/contact.php [L,QSA]
RewriteRule ^api/chat/?$ api/chat.php [L,QSA]

# Serve static files directly if they exist
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback to index.html
RewriteRule ^ index.html [L]
