# MongoDB Atlas / Vercel MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/zayd-portfolio?retryWrites=true&w=majority

# Optional Server Port
PORT=3000

# Kapso WhatsApp Cloud API Credentials (https://kapso.ai)
KAPSO_API_KEY=your_kapso_api_key_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=zayd_portfolio_verify_token
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp


# Secret used by the private admin mobile app (admin_app/). Min 20 characters.
# Generate one with:  openssl rand -hex 32
# Leave empty to keep the admin API disabled.
ADMIN_API_KEY=

# --- WhatsApp automation (disabled by default) ---------------------------------------------
# Set to "true" to process incoming WhatsApp messages (auto-replies, owner commands, approvals).
WHATSAPP_ENABLED=false
# Shared secret used to sign Kapso webhooks. Owner commands are ignored unless the signature is valid.
KAPSO_WEBHOOK_SECRET=
# Token you enter in Kapso/Meta when registering the webhook URL (no built-in default).
WHATSAPP_VERIFY_TOKEN=
# Your private WhatsApp number (digits, with country code). Only this number can approve changes.
WHATSAPP_PHONE=

# Used by scripts/auto-sync-portfolio.js and scripts/generate-showcase.js to read/apply the live portfolio
PORTFOLIO_URL=https://your-portfolio.vercel.app

# --- CV generation ----------------------------------------------------------------------------
# Secret shared with the GitHub Action that compiles the CV (min 20 chars): openssl rand -hex 32
# Also add it as the repository secret CV_BUILD_KEY (plus PORTFOLIO_URL) in GitHub -> Settings -> Secrets -> Actions.
CV_BUILD_KEY=
# Optional: lets the site start the CV build immediately instead of waiting for the 30-minute poll.
# Use a fine-grained personal access token with "Actions: Read and write" on this repository.
GITHUB_TOKEN=
