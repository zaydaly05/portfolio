{
  "name": "zayd-portfolio",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sync": "node scripts/auto-sync-portfolio.js",
    "upload-media": "node scripts/upload-to-cloudinary.js",
    "upload-media:replace": "node scripts/upload-to-cloudinary.js --replace",
    "test-notify": "node --env-file=.env.local scripts/test-notify.js",
    "check-secrets": "node scripts/verify-credentials.js",
    "lint": "npx eslint server.js public/script.js scripts/",
    "lint:fix": "npx eslint --fix server.js public/script.js scripts/",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:unit": "node --test \"test-unit/*.test.js\"",
    "verify:components": "node scripts/verify-layout-components.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Dynamic professional portfolio for Zayd Ali Mohamed",
  "dependencies": {
    "@kapso/whatsapp-cloud-api": "^0.3.0",
    "cloudinary": "^2.11.0",
    "express": "^5.2.1",
    "mongoose": "^9.10.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-formatter-compact": "^9.0.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
