{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/assets/cv.pdf", "destination": "/assets/Zayd%20Ali%20Mohamed%20CV.pdf" },
    { "source": "/assets/Zayd_Ali_Mohamed_CV.pdf", "destination": "/assets/Zayd%20Ali%20Mohamed%20CV.pdf" },
    { "source": "/cv.pdf", "destination": "/assets/Zayd%20Ali%20Mohamed%20CV.pdf" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/projects", "destination": "/api/index.js" },
    { "source": "/experience", "destination": "/api/index.js" },
    { "source": "/skills", "destination": "/api/index.js" },
    { "source": "/contact", "destination": "/api/index.js" }
  ],

  "crons": [
    {
      "path": "/api/github",
      "schedule": "0 0 * * *"
    }
  ]
}
